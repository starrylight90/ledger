# Core infrastructure
KAFKA_BROKER=redpanda:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
DATABASE_URL=postgresql://ledger:ledger@postgres:5432/ledger

# Service-level schema defaults
ORDER_DB_SCHEMA=order
INVENTORY_DB_SCHEMA=inventory
PAYMENT_DB_SCHEMA=payment
NOTIFICATION_DB_SCHEMA=notification

# Service networking
ORDER_SERVICE_HOST=0.0.0.0
ORDER_SERVICE_PORT=8000
INVENTORY_SERVICE_HOST=0.0.0.0
INVENTORY_SERVICE_PORT=8001
PAYMENT_SERVICE_HOST=0.0.0.0
PAYMENT_SERVICE_PORT=8002
NOTIFICATION_SERVICE_HOST=0.0.0.0
NOTIFICATION_SERVICE_PORT=8003

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Feature and runtime defaults
LOG_LEVEL=INFO
ENVIRONMENT=local

# Comma-separated customer IDs that always fail in payment-service
PAYMENT_FAIL_CUSTOMER_IDS=
